                           <font>
                              <Font size="32.0" />
                           </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#sletUndervisningsmatriale" text="Slet">
                           <font>
                              <Font size="32.0" />
                           </font>
                        </Button>
                     </children>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </HBox>
                  <Accordion prefWidth="1400.0">
                    <panes>
                      <TitledPane animated="false" prefWidth="1400.0" text="Indskoling (0. - 3. klasse)">
                           <font>
                              <Font size="32.0" />
                           </font>
                           <content>
                              <ListView fx:id="indskolingData" prefWidth="1400.0" />
                           </content>
                      </TitledPane>
                      <TitledPane animated="false" prefWidth="1400.0" text="Mellemtrin (4. - 6. klasse)">
                           <font>
                              <Font size="32.0" />
                           </font>
                           <content>
                              <ListView fx:id="mellemtrinData" prefWidth="1400.0" />
                           </content>
                      </TitledPane>
                      <TitledPane animated="false" prefWidth="1400.0" text="Udskoling (7. - 9. (10.) klasse)">
                           <font>
                              <Font size="32.0" />
                           </font>
                           <content>
                              <ListView fx:id="udskolingData" prefWidth="1400.0" />
                           </content>
                      </TitledPane>
                        <TitledPane prefWidth="1400.0" text="Konfirmation">
                           <font>
                              <Font size="32.0" />
                           </font>
                           <content>
                              <ListView fx:id="konfirmationData" prefWidth="1400.0" />
                           </content>
                        </TitledPane>
                    </panes>
                  </Accordion>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
